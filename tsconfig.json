{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "lib": ["esnext", "dom", "dom.iterable"]
    },
    "include": ["src/**/*.js", "src/**/*.d.ts", "paper-preview/src/**/*.js", "paper-preview/src/**/*.d.ts"],
    "exclude": ["node_modules", "dist"]
}
